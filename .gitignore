# dependencies
node_modules/
.pnp
.pnp.js

# build output
dist/
dist_ssr/
.vite/

# native platforms (generated on demand by `npx cap add android|ios`)
android/
ios/

# secrets / local config
.env
.env.local
.env.*.local
*.keystore
*.jks
keystore.properties

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# editors & os
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# tsc -b composite 临时产物
dist-node-tmp/
*.tsbuildinfo

# 本地数据与密钥
# 注意：只忽略仓库根目录的 data/，不要写成裸的 data/，
# 否则会连 src/data/ 一起误伤（cet4 题库就因为这条规则漏提交过）。
/data/
.env
